generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @db.Char(36)
  username     String    @unique @db.VarChar(191)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(USER)
  avatarUrl    String?   @db.VarChar(255)
  bio          String?   @db.Text
  prompts      Prompt[]
  reactions    Reaction[]
  saves        Save[]
  favorites    Favorite[]
  reposts      Repost[]
  comments     Comment[]
  followers    Follow[]  @relation("followers")
  following    Follow[]  @relation("following")
  createdAt    DateTime  @default(now())
}

enum Role {
  ADMIN
  USER
}

model Section {
  id              String   @id @db.Char(36)
  slug            String   @unique @db.VarChar(191)
  name_i18n       Json
  description_i18n Json
  order           Int
  agents          Agent[]
}

model Agent {
  id              String   @id @db.Char(36)
  sectionId       String   @db.Char(36)
  slug            String   @unique @db.VarChar(191)
  name_i18n       Json
  description_i18n Json
  homepageUrl     String?  @db.VarChar(255)
  order           Int
  isActive        Boolean  @default(true)
  section         Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prompts         Prompt[]
}

model Prompt {
  id        String    @id @db.Char(36)
  userId    String    @db.Char(36)
  agentId   String?   @db.Char(36)
  title     String    @db.VarChar(255)
  body      String    @db.Text
  lang      String    @db.VarChar(10)
  isPublic  Boolean   @default(true)
  tags      Json
  reactions Reaction[]
  saves     Save[]
  favorites Favorite[]
  reposts   Repost[]
  comments  Comment[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Reaction {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  promptId  String   @db.Char(36)
  type      ReactionType
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([promptId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Save {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  promptId  String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
}

model Favorite {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  promptId  String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
}

model Repost {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  promptId  String   @db.Char(36)
  comment   String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
}

model Comment {
  id        String    @id @db.Char(36)
  userId    String    @db.Char(36)
  promptId  String    @db.Char(36)
  parentId  String?   @db.Char(36)
  body      String    @db.Text
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentChildren", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentChildren")
  createdAt DateTime  @default(now())

  @@index([promptId])
}

model Follow {
  id          String @id @db.Char(36)
  followerId  String @db.Char(36)
  followingId String @db.Char(36)
  follower    User   @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}
